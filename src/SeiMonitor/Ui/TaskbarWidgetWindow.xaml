<Window x:Class="SeiMonitor.Ui.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEI Monitor — Taskbar Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="250" Height="40"
        MouseEnter="OnWidgetMouseEnter"
        MouseLeave="OnWidgetMouseLeave"
        MouseLeftButtonUp="OnWidgetMouseClick">

    <Border x:Name="PillBorder"
            Background="{DynamicResource OverlaySurface}"
            BorderThickness="0"
            CornerRadius="0"
            Padding="8,0,8,0"
            Cursor="Hand">

        <Grid VerticalAlignment="Center">
            <!-- Estado Padrão: Indicadores fixos iguais aos do Desktop -->
            <StackPanel x:Name="IndicatorsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <!-- Monitorados -->
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0" ToolTip="Monitorados">
                    <TextBlock Text="📂" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock x:Name="TxtIndMonitorados" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Novos Andamentos -->
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0" ToolTip="Novos Andamentos">
                    <TextBlock Text="⚡" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock x:Name="TxtIndNovos" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Para Mim -->
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0" ToolTip="Destinados a Você">
                    <TextBlock Text="🎯" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock x:Name="TxtIndParaMim" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Terceiros -->
                <StackPanel Orientation="Horizontal" ToolTip="Abertos por Terceiro (GINFO)">
                    <TextBlock Text="👁️" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock x:Name="TxtIndTerceiros" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Estado de Notificação: Scrolling horizontal temporário apenas quando há push -->
            <Grid x:Name="TickerPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        x:Name="IconBadge"
                        Background="#EA580C"
                        CornerRadius="9"
                        Width="18" Height="18"
                        Margin="0,0,8,0">
                    <TextBlock x:Name="TxtIcon"
                               Text="⚡"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Grid Grid.Column="1" ClipToBounds="True" Height="22">
                    <Canvas x:Name="TickerCanvas" Height="22">
                        <TextBlock x:Name="TickerText"
                                   Text=""
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg}"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TickerTransform" X="0" Y="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Grid>

                <Border x:Name="CountBadge"
                        Grid.Column="2"
                        Background="#374151"
                        CornerRadius="8"
                        Padding="5,1"
                        Margin="6,0,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtCount"
                               Text="0"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
