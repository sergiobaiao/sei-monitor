<Window x:Class="SeiMonitor.Ui.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEI Monitor — Desktop Fence"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Width="380" Height="600"
        MinWidth="280" MaxWidth="800"
        MinHeight="50" MaxHeight="1200">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#E618181B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Linha 0: Cabeçalho com Arraste -->
                <RowDefinition Height="Auto"/>
                <!-- Linha 1: Corpo (Pills + Lista) -->
                <RowDefinition Height="*" x:Name="RowBody"/>
                <!-- Linha 2: Rodapé (Timestamp + Thumb de resize) -->
                <RowDefinition Height="Auto" x:Name="RowFooter"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    x:Name="HeaderBorder"
                    Background="#202024"
                    CornerRadius="11,11,0,0"
                    Padding="10,8"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="OnHeaderDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="13" Foreground="#0078D4" Margin="0,0,6,0"/>
                        <TextBlock Text="SEI Monitor" FontWeight="Bold" FontSize="12" Foreground="#F4F4F5"/>
                    </StackPanel>

                    <!-- Dropdown de Grupos -->
                    <ComboBox Grid.Column="1"
                              x:Name="CmbGroups"
                              Margin="10,0,8,0"
                              Height="24"
                              FontSize="11"
                              DisplayMemberPath="Nome"
                              SelectedValuePath="Id"
                              SelectionChanged="OnGroupSelectionChanged"
                              VerticalAlignment="Center"/>

                    <!-- Botões de Ação -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSync"
                                Content="🔄"
                                FontSize="12"
                                Width="24" Height="24"
                                Background="Transparent"
                                Foreground="#A1A1AA"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Sincronizar agora"
                                Click="OnSyncClick"
                                Margin="0,0,4,0"/>
                        <Button x:Name="BtnCollapse"
                                Content="▾"
                                FontSize="12"
                                Width="24" Height="24"
                                Background="Transparent"
                                Foreground="#A1A1AA"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Recolher / Expandir"
                                Click="OnCollapseClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Corpo -->
            <Grid Grid.Row="1" x:Name="BodyGrid" Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 4 Pills de Contagem -->
                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                    <!-- Pill Monitorados -->
                    <Border Background="#1E1E24" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="4,4" Margin="2,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📂" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCntMonitored" Text="0" FontWeight="Bold" FontSize="12" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                            <TextBlock Text="MONITORADOS" FontSize="7" FontWeight="SemiBold" Foreground="#DDD6FE" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Pill Novos Andamentos -->
                    <Border Background="#10202E" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="6" Padding="4,4" Margin="2,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCntNewDocs" Text="0" FontWeight="Bold" FontSize="12" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                            <TextBlock Text="NOVOS" FontSize="7" FontWeight="SemiBold" Foreground="#BFDBFE" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Pill Para Mim -->
                    <Border Background="#102E20" BorderBrush="#065F46" BorderThickness="1" CornerRadius="6" Padding="4,4" Margin="2,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎯" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCntDestined" Text="0" FontWeight="Bold" FontSize="12" Foreground="#34D399" HorizontalAlignment="Center"/>
                            <TextBlock Text="PARA MIM" FontSize="7" FontWeight="SemiBold" Foreground="#A7F3D0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Pill Terceiros -->
                    <Border Background="#2E2310" BorderBrush="#78350F" BorderThickness="1" CornerRadius="6" Padding="4,4" Margin="2,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👁️" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCntAttention" Text="0" FontWeight="Bold" FontSize="12" Foreground="#FBBF24" HorizontalAlignment="Center"/>
                            <TextBlock Text="TERCEIROS" FontSize="7" FontWeight="SemiBold" Foreground="#FDE68A" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Lista de Processos -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListProcesses">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E24"
                                        BorderBrush="#2E2E33"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,6"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding ProtocoloFormatado}" FontWeight="Bold" FontSize="11" Foreground="#F4F4F5"/>
                                            <TextBlock Text="🎯" Visibility="{Binding DestinadoAoUsuario, Converter={StaticResource BoolToVis}}"
                                                       Foreground="#34D399" FontSize="10" Margin="4,0,0,0" ToolTip="Destinado a você"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding UltimaAtividadeDesc}" FontSize="10" Foreground="#A1A1AA"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Rodapé -->
            <Grid Grid.Row="2" x:Name="FooterGrid" Margin="10,0,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtLastSync"
                           Grid.Column="0"
                           Text="Aguardando sincronização..."
                           FontSize="10"
                           Foreground="#71717A"
                           VerticalAlignment="Center"/>

                <!-- Thumb de Redimensionamento -->
                <Thumb Grid.Column="1"
                       Width="18" Height="18"
                       Cursor="SizeNWSE"
                       DragDelta="OnResize"
                       DragCompleted="OnResizeDone">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <TextBlock Text="⤡"
                                       FontSize="13"
                                       Foreground="#71717A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Grid>
    </Border>
</Window>
