<Window x:Class="SeiMonitor.Ui.TaskbarFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEI Monitor — Visão Rápida"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="380" Height="520">

    <Border Background="#F218181B"
            BorderBrush="#2E2E33"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Cabeçalho com saudação e ações -->
                <RowDefinition Height="Auto"/>
                <!-- Contadores (Pills) -->
                <RowDefinition Height="Auto"/>
                <!-- Conteúdo com Scroll -->
                <RowDefinition Height="*"/>
                <!-- Rodapé -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtGreeting"
                               Text="Boa tarde, Usuário"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#F4F4F5"/>
                    <TextBlock x:Name="TxtSubheader"
                               Text="Unidade: GINFO"
                               FontSize="11"
                               Foreground="#A1A1AA"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSync"
                            Content="🔄"
                            FontSize="13"
                            Width="28" Height="28"
                            Cursor="Hand"
                            Background="Transparent"
                            Foreground="#A1A1AA"
                            BorderThickness="0"
                            ToolTip="Sincronizar agora com o SEI"
                            Click="OnSyncClick"
                            Margin="0,0,4,0"/>
                    <Button Content="✕"
                            FontSize="13"
                            Width="28" Height="28"
                            Cursor="Hand"
                            Background="Transparent"
                            Foreground="#A1A1AA"
                            BorderThickness="0"
                            ToolTip="Fechar painel"
                            Click="OnCloseClick"/>
                </StackPanel>
            </Grid>

            <!-- 2. Contadores (Pills) -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                <!-- Pill Destinados -->
                <Border Background="#2E1010" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="6,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎯" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CntDestinados" Text="0" FontWeight="Bold" FontSize="14" Foreground="#EF4444" HorizontalAlignment="Center"/>
                        <TextBlock Text="DESTINADOS" FontSize="8" FontWeight="SemiBold" Foreground="#FCA5A5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Pill Terceiros -->
                <Border Background="#2E2310" BorderBrush="#78350F" BorderThickness="1" CornerRadius="8" Padding="6,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👁️" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CntTerceiros" Text="0" FontWeight="Bold" FontSize="14" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                        <TextBlock Text="TERCEIROS" FontSize="8" FontWeight="SemiBold" Foreground="#FDE68A" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Pill Acompanhamento -->
                <Border Background="#10202E" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="8" Padding="6,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📂" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CntAcomp" Text="0" FontWeight="Bold" FontSize="14" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                        <TextBlock Text="ACOMP." FontSize="8" FontWeight="SemiBold" Foreground="#BFDBFE" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Pill Caixa -->
                <Border Background="#1E1E24" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="6,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📥" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CntCaixa" Text="0" FontWeight="Bold" FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                        <TextBlock Text="CAIXA" FontSize="8" FontWeight="SemiBold" Foreground="#E5E7EB" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 3. Lista de Cards com Scroll -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Card 1: Destinados a Você -->
                    <Border Background="#1E1E24" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="🎯 Destinados a Você" FontWeight="Bold" FontSize="12" Foreground="#FCA5A5"/>
                                <TextBlock x:Name="BadgeDestinadosHeader" Text="(0)" FontSize="11" Foreground="#A1A1AA" Margin="4,0,0,0"/>
                            </DockPanel>
                            <StackPanel x:Name="PanelDestinados"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Últimas Movimentações na Unidade -->
                    <Border Background="#1E1E24" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="⚡ Últimas Movimentações" FontWeight="Bold" FontSize="12" Foreground="#F4F4F5"/>
                                <TextBlock x:Name="BadgeMovimentacoesHeader" Text="" FontSize="11" Foreground="#A1A1AA" Margin="4,0,0,0"/>
                            </DockPanel>
                            <StackPanel x:Name="PanelMovimentacoes"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Rodapé -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtLastSync"
                           Text="Aguardando sincronização..."
                           FontSize="10"
                           Foreground="#71717A"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Abrir Painel Completo ↗"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Padding="12,6"
                        Cursor="Hand"
                        Background="#0078D4"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Click="OnOpenMainPanelClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
