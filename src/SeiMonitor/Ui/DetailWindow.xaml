<Window x:Class="SeiMonitor.Ui.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Detalhes do Processo — SEI Monitor"
        Height="720" Width="960"
        MinHeight="540" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg0}"
        Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Cabeçalho com Metadados e Ações -->
            <RowDefinition Height="Auto"/>
            <!-- Abas (Andamentos e Documentos) -->
            <RowDefinition Height="*"/>
            <!-- Rodapé / Barra de Status -->
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- 1. Cabeçalho do Processo -->
        <Border Grid.Row="0" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Linha 1: Número do Processo, Badges e Botões -->
                <DockPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProtocolo" Text="00000.000000/2026-00" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                        
                        <Button x:Name="BtnCopyNumber" Content="📋" ToolTip="Copiar número do processo"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                Click="OnCopyNumberClick" VerticalAlignment="Center"/>

                        <!-- Badges de Negócio -->
                        <Border x:Name="BadgeDestined" Background="{DynamicResource PillDestinedBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,4,0" Visibility="Collapsed">
                            <TextBlock Text="🎯 DESTINADO A VOCÊ" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>

                        <Border x:Name="BadgeAttention" Background="{DynamicResource PillAttentionBrush}" CornerRadius="4" Padding="6,2" Margin="4,0,4,0" Visibility="Collapsed">
                            <TextBlock Text="⚠️ ABERTO POR COLEGA" FontSize="10" FontWeight="Bold" Foreground="#000000"/>
                        </Border>

                        <Border x:Name="BadgeReadStatus" Background="{DynamicResource Bg3}" CornerRadius="4" Padding="6,2" Margin="4,0">
                            <TextBlock x:Name="TxtReadStatus" Text="⚡ NÃO LIDO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PillNewDocsBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Ações Rápidas -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleRead" Content="✓ Marcar como Lido" Padding="10,5" Margin="0,0,8,0"
                                Background="{DynamicResource Bg3}" Foreground="{DynamicResource Fg}" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand" Click="OnToggleReadClick"/>
                        
                        <Button x:Name="BtnOpenInBrowser" Content="🌐 Abrir no Navegador (SEI)" Padding="12,5"
                                Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Click="OnOpenInBrowserClick"/>
                    </StackPanel>
                </DockPanel>

                <!-- Linha 2: Metadados do Processo -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtTipoProcesso" Text="Tipo: Administrativo Geral" FontSize="13" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtDescricao" Text="Descrição / Interessados: N/A" FontSize="12" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtUnidadeSigla" Text="Unidade: GINFO" FontSize="12" Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtNivelAcesso" Text="Nível de Acesso: Público" FontSize="11" Foreground="{DynamicResource FgDim}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Abas de Detalhamento -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="16">
            
            <!-- ABA A: LINHA DO TEMPO DE ANDAMENTOS -->
            <TabItem Header="📜 Linha do Tempo de Andamentos" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TimelineList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Card de Andamento com destaque de Terceiro -->
                                    <Border Margin="0,0,0,10" CornerRadius="8" Padding="14"
                                            BorderThickness="{Binding BorderThickness}"
                                            BorderBrush="{Binding BorderBrush}"
                                            Background="{Binding BackgroundBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Ícone / Marcador de Linha do Tempo -->
                                            <TextBlock Grid.Column="0" Text="{Binding IconMarker}" FontSize="18"
                                                       Foreground="{Binding MarkerColor}" VerticalAlignment="Top" Margin="0,2,0,0"/>

                                            <!-- Conteúdo do Andamento -->
                                            <StackPanel Grid.Column="1">
                                                <!-- Alerta Visual quando Aberto por Colega -->
                                                <Border Background="{DynamicResource PillAttentionBrush}" CornerRadius="4" Padding="6,2"
                                                        HorizontalAlignment="Left" Visibility="{Binding IsOpenedByThirdParty, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,0,4">
                                                    <TextBlock Text="⚠️ ATENÇÃO: COLEGA VISUALIZOU SEM DESPACHAR" FontSize="10" FontWeight="Bold" Foreground="#000000"/>
                                                </Border>

                                                <TextBlock Text="{Binding Descricao}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                                <!-- Detalhes do Servidor e Unidade -->
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="Servidor: " FontSize="11" Foreground="{DynamicResource FgDim}"/>
                                                    <TextBlock Text="{Binding Usuario}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgMuted}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Unidade: " FontSize="11" Foreground="{DynamicResource FgDim}"/>
                                                    <TextBlock Text="{Binding Unidade}" FontSize="11" Foreground="{DynamicResource FgMuted}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Data e Hora -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding DataHora}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ABA B: ÁRVORE / LISTA DE DOCUMENTOS -->
            <TabItem Header="📁 Documentos do Processo" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <DataGrid x:Name="DgDocuments" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding NomeComposto}" Width="*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="NÚMERO" Binding="{Binding ProtocoloFormatado}" Width="160"/>
                            <DataGridTextColumn Header="TIPO" Binding="{Binding TipoDocumento}" Width="110"/>
                            <DataGridTextColumn Header="INCLUSÃO" Binding="{Binding DataInclusao}" Width="140"/>
                            <DataGridTemplateColumn Header="STATUS" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource UrgentBrush}" CornerRadius="3" Padding="4,1" Margin="2,0"
                                                    Visibility="{Binding Cancelado, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Cancelado" FontSize="9" Foreground="#FFFFFF"/>
                                            </Border>
                                            <Border Background="{DynamicResource PillMonitoredBrush}" CornerRadius="3" Padding="4,1" Margin="2,0"
                                                    Visibility="{Binding Sigiloso, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Sigiloso" FontSize="9" Foreground="#FFFFFF"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. Barra de Status Inferior -->
        <Border Grid.Row="2" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="PbLoading" IsIndeterminate="True" Width="80" Height="10" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtFooterStatus" Text="Carregando dados completos do SEI..." FontSize="11" Foreground="{DynamicResource FgDim}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 Recarregar" Background="Transparent" Foreground="{DynamicResource FgMuted}" BorderThickness="0" Cursor="Hand" Click="OnReloadClick" Margin="0,0,12,0"/>
                    <Button Content="Fechar (Esc)" Background="Transparent" Foreground="{DynamicResource FgMuted}" BorderThickness="0" Cursor="Hand" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
